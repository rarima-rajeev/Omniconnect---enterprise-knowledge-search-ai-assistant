# AskWell - Permission-Aware Enterprise Knowledge Search
# Copy to .env.local and fill in. Never commit .env.local.

# --- SUPABASE (required): Postgres + pgvector. Run supabase/schema.sql once in the SQL editor ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- GEMINI (required): embeddings + answers. Get a key at https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# RAG_CHUNK_SET=small

# --- SESSIONS (recommended): signs the session cookie. Generate with: openssl rand -hex 32 ---
SESSION_SECRET=

# --- POSTHOG TELEMETRY (optional - defaults to in-memory observability feed) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
